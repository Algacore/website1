---
// Plain prose page for the legal notice and the privacy policy. Same tokens as
// the rest of the site, no new design language.
import type { LegalDoc } from "@/lib/content";
interface Props {
  doc: LegalDoc;
  homeHref: string;
}
const { doc, homeHref } = Astro.props;
---

<section id="doc" class="section-pad pt-[clamp(128px,17vh,184px)]">
  <div class="container">
    <div class="max-w-[var(--maxw-narrow)]">
      <h1 class="font-display tracking-[-0.025em] text-[clamp(2.2rem,5vw,3.4rem)] leading-[1.06]">
        {doc.title}
      </h1>
      <p class="text-muted mt-3 text-[0.85rem] tracking-[0.02em]">{doc.updated}</p>
      <p class="text-muted mt-6 text-[1.075rem] leading-relaxed">{doc.lede}</p>

      <hr class="rule-fade my-[clamp(32px,5vw,48px)]" />

      <div class="grid gap-[clamp(28px,4vw,40px)]">
        {
          doc.sections.map((s) => (
            <section>
              <h2 class="text-[1.2rem] font-semibold tracking-[-0.01em] mb-3">{s.title}</h2>
              {s.body.map((p) => (
                <p class="text-muted leading-relaxed mb-3 last:mb-0">{p}</p>
              ))}
            </section>
          ))
        }
      </div>

      <hr class="rule-fade my-[clamp(32px,5vw,48px)]" />

      <a href={homeHref} class="font-medium text-accent-text hover:underline underline-offset-[3px]">
        ← {doc.back}
      </a>
    </div>
  </div>
</section>
