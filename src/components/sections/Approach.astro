---
import SectionHead from "@/components/SectionHead.astro";
import Compare from "@/components/sections/parts/Compare.astro";
import type { SiteContent } from "@/lib/content";
interface Props {
  approach: SiteContent["approach"];
}
const { approach } = Astro.props;
---

<section id="approach" class="section-pad section-alt relative atmos" data-theme="light">
  <div class="container">
    <SectionHead chapter="02" eyebrow={approach.eyebrow} title={approach.title} />

    <div class="grid gap-5 md:gap-6 md:grid-cols-3">
      {
        approach.cards.map((card, i) => (
          <article
            class={`card card--hover card--sheen reveal ${i >= 1 ? "card--glass " : ""}${i === 2 ? "border-phyco-200!" : ""}`}
            style={`--i:${i}`}
          >
            <h3 class={`text-xl tracking-[-0.01em] mb-4 ${i === 2 ? "text-accent-text" : ""}`}>
              {card.title}
            </h3>
            <p class="text-muted">{card.body}</p>
          </article>
        ))
      }
    </div>

    <div class="block-gap-lg reveal">
      {/* Head sits right, over the Algacore column, so the eye lands on the
          promoted panel rather than the legacy one. */}
      <div class="max-w-[46ch] ml-auto mb-[clamp(20px,3vw,30px)]">
        <h3 class="font-semibold tracking-[-0.02em] mb-3 text-right! text-[clamp(1.5rem,2.9vw,2.05rem)]">
          {approach.compareTitle}
        </h3>
        {/* Justified, with the last line pushed right, so the lede reads as a
            clean rectangle flush to both edges of the same box as the title. */}
        <p class="text-muted text-justify! [text-align-last:right] text-[1.02rem]">{approach.compareLede}</p>
      </div>

      <Compare
        pondAlt={approach.pondAlt}
        pondTag={approach.pondTag}
        pondLabel={approach.pondLabel}
        pond={approach.pond}
        pbrAlt={approach.pbrAlt}
        pbrTag={approach.pbrTag}
        pbrLabel={approach.pbrLabel}
        pbr={approach.pbr}
      />
    </div>
  </div>
</section>
