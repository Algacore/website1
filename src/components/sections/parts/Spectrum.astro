---
interface Props {
  alt: string;
  caption: string;
  peakLabel: string;
}

const { alt, caption, peakLabel } = Astro.props;

const CURVE =
  "M20 196 C140 192 260 184 330 172 C380 160 405 110 431 40 C458 104 490 152 528 174 C552 184 568 188 580 190";
const GLOW =
  "M20 196 C140 192 260 184 330 172 C380 160 405 110 431 40 C458 104 490 152 528 174 C552 184 568 188 580 190 L580 200 L20 200 Z";
---

<div class="min-w-0" data-spectrum>
  <svg viewBox="0 0 600 240" role="img" aria-label={alt} class="w-full h-auto block overflow-visible" style="aspect-ratio: 600/240">
    <defs>
      <linearGradient id="sigStroke" x1="0" y1="0" x2="600" y2="0" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#73c5ff"></stop>
        <stop offset="0.55" stop-color="#36a9f5"></stop>
        <stop offset="1" stop-color="#73c5ff"></stop>
      </linearGradient>
      <linearGradient id="sigGlow" x1="0" y1="0" x2="0" y2="240" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#73c5ff" stop-opacity="0.45"></stop>
        <stop offset="1" stop-color="#73c5ff" stop-opacity="0"></stop>
      </linearGradient>
      <radialGradient id="sigPeak" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="translate(431 40) scale(52)">
        <stop offset="0" stop-color="#d1eeff" stop-opacity="0.85"></stop>
        <stop offset="1" stop-color="#d1eeff" stop-opacity="0"></stop>
      </radialGradient>
    </defs>

    <line x1="20" y1="200" x2="580" y2="200" stroke="rgba(255,255,255,0.22)" stroke-width="1"></line>
    <g stroke="rgba(255,255,255,0.22)" stroke-width="1">
      <line x1="20" y1="200" x2="20" y2="206"></line>
      <line x1="206.7" y1="200" x2="206.7" y2="206"></line>
      <line x1="393.3" y1="200" x2="393.3" y2="206"></line>
      <line x1="580" y1="200" x2="580" y2="206"></line>
    </g>
    <g fill="rgba(255,255,255,0.52)" font-size="11" font-weight="500" style="letter-spacing: 0.04em" text-anchor="middle">
      <text x="20" y="222">400</text>
      <text x="206.7" y="222">500</text>
      <text x="393.3" y="222">600</text>
      <text x="580" y="222">700</text>
      <text x="552" y="236">nm</text>
    </g>

    <path d={GLOW} fill="url(#sigGlow)" class="sig-glow"></path>

    <line x1="431" y1="46" x2="431" y2="200" stroke="#73c5ff" stroke-width="1" stroke-dasharray="2 4" class="sig-peakline"></line>
    <text x="431" y="34" fill="#73c5ff" font-size="12" font-weight="600" text-anchor="middle" style="letter-spacing: 0.03em" class="sig-peaktext">
      {peakLabel}
    </text>

    <path
      d={CURVE}
      fill="none"
      stroke="url(#sigStroke)"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
      pathLength="1"
      style="filter: drop-shadow(0 0 6px rgba(115,197,255,0.55))"
      class="sig-curve"
      data-sig-curve></path>

    <circle cx="431" cy="40" r="44" fill="url(#sigPeak)"></circle>
    <circle
      cx="431"
      cy="40"
      r="4.5"
      fill="#eaf8ff"
      style="filter: drop-shadow(0 0 7px rgba(115,197,255,0.9)); transform-box: fill-box; transform-origin: center"
      class="sig-dot"></circle>
  </svg>
  <figcaption class="mt-1 text-[0.74rem] text-white/55" style="letter-spacing: 0.01em">
    {caption}
  </figcaption>
</div>

<style>
  /* Staged entrance: curve draws first, glow fades under it, then the 620nm
     peak marker, label and dot pop. All visible-by-default without JS. */
  :global(html.js) .sig-curve {
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
  }
  :global(html.js) .sig-glow,
  :global(html.js) .sig-peaktext {
    opacity: 0;
  }
  :global(html.js) .sig-peakline {
    opacity: 0;
  }
  :global(html.js) .sig-dot {
    transform: scale(0);
    opacity: 0;
  }

  [data-spectrum].is-on .sig-curve {
    animation: sigDraw 1.9s var(--ease-brand) 0.15s forwards;
  }
  [data-spectrum].is-on .sig-glow {
    animation: sigFade 1s ease 1.15s forwards;
  }
  [data-spectrum].is-on .sig-peakline {
    animation: sigFadeDim 0.8s ease 1.5s forwards;
  }
  [data-spectrum].is-on .sig-peaktext {
    animation: sigFade 0.8s ease 1.5s forwards;
  }
  [data-spectrum].is-on .sig-dot {
    animation: sigPop 0.6s var(--ease-brand) 1.45s forwards;
  }

  @keyframes sigDraw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes sigFade {
    to {
      opacity: 1;
    }
  }
  @keyframes sigFadeDim {
    to {
      opacity: 0.65;
    }
  }
  @keyframes sigPop {
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .sig-curve {
      stroke-dashoffset: 0;
      animation: none;
    }
    :global(html.js) .sig-glow,
    :global(html.js) .sig-peaktext {
      opacity: 1;
      animation: none;
    }
    :global(html.js) .sig-peakline {
      opacity: 0.65;
      animation: none;
    }
    :global(html.js) .sig-dot {
      transform: none;
      opacity: 1;
      animation: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-spectrum]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (root) {
    if (reduce || !("IntersectionObserver" in window)) {
      root.classList.add("is-on");
    } else {
      const io = new IntersectionObserver(
        ([entry], obs) => {
          if (entry.isIntersecting) {
            root.classList.add("is-on");
            obs.disconnect();
          }
        },
        { rootMargin: "0px 0px -10% 0px" },
      );
      io.observe(root);
    }
  }
</script>
