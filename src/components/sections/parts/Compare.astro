---
interface Props {
  pondAlt: string;
  pondTag: string;
  pondLabel: string;
  pond: string[];
  pbrAlt: string;
  pbrTag: string;
  pbrLabel: string;
  pbr: string[];
}

const { pondAlt, pondTag, pondLabel, pond, pbrAlt, pbrTag, pbrLabel, pbr } = Astro.props;

const serpentine =
  "M84 58 H246 A14 14 0 0 1 246 86 H84 A14 14 0 0 0 84 114 H246 A14 14 0 0 1 246 142 H84";

// Centerline of the raceway channel (a stadium loop the paddlewheel circulates).
const racewayLoop = "M82 88 H238 A42 42 0 0 1 238 172 H82 A42 42 0 0 1 82 88 Z";
---

<div class="grid gap-4 md:grid-cols-2 md:gap-5" data-compare>
  <!-- Open raceway pond: quiet, neutral, the legacy way. -->
  <article class="card card--hover card--sheen md:p-7" data-panel="pond">
    <svg viewBox="0 0 320 200" role="img" aria-label={pondAlt} class="w-full h-auto block mb-[18px] md:mb-5" style="aspect-ratio: 320/200">
      <g fill="none" stroke="#aeb6ba" stroke-width="1.5" stroke-linecap="round">
        <circle cx="40" cy="30" r="9" fill="#cbd3d7" stroke="none"></circle>
        <g stroke="#cbd3d7">
          <line x1="40" y1="11" x2="40" y2="16"></line>
          <line x1="40" y1="44" x2="40" y2="49"></line>
          <line x1="21" y1="30" x2="26" y2="30"></line>
          <line x1="54" y1="30" x2="59" y2="30"></line>
          <line x1="26.5" y1="16.5" x2="30" y2="20"></line>
          <line x1="50" y1="40" x2="53.5" y2="43.5"></line>
          <line x1="53.5" y1="16.5" x2="50" y2="20"></line>
          <line x1="30" y1="40" x2="26.5" y2="43.5"></line>
        </g>
        <g fill="#aeb6ba" stroke="none">
          <circle cx="150" cy="24" r="2"></circle>
          <circle cx="178" cy="36" r="1.6"></circle>
          <circle cx="206" cy="22" r="1.8"></circle>
          <circle cx="232" cy="38" r="2.2"></circle>
          <circle cx="120" cy="40" r="1.4"></circle>
        </g>
        <path d="M258 20 L258 50"></path>
        <path d="M253 44 L258 50 L263 44"></path>
        <g stroke="#8e979b" class="cmp-evap">
          <path d="M96 70 q-5 -9 0 -18 q5 -9 0 -18"></path>
          <path d="M224 70 q-5 -9 0 -18 q5 -9 0 -18"></path>
        </g>
      </g>
      <rect x="26" y="74" width="268" height="112" rx="56" fill="#96c3dd" stroke="#6e767a" stroke-width="1.5"></rect>
      <rect x="54" y="102" width="212" height="56" rx="28" fill="#cbd3d7" stroke="#8e979b" stroke-width="1.5"></rect>
      <!-- Sluggish circulating water: quiet, low-contrast, the legacy way. -->
      <path
        d={racewayLoop}
        fill="none"
        stroke="#7ba5c2"
        stroke-width="2"
        stroke-linecap="round"
        stroke-dasharray="3 17"
        opacity="0.5"
        class="cmp-raceway"></path>
      <g stroke="#50585c" stroke-width="1.5" fill="#e2e8ec">
        <rect x="100" y="74" width="20" height="14" rx="2"></rect>
      </g>
      <!-- Paddlewheel that pushes the loop, turning slowly. -->
      <g stroke="#50585c" stroke-width="1.5" stroke-linecap="round" class="cmp-wheel">
        <line x1="110" y1="74.5" x2="110" y2="87.5"></line>
        <line x1="103.5" y1="81" x2="116.5" y2="81"></line>
        <line x1="105" y1="76" x2="115" y2="86"></line>
        <line x1="115" y1="76" x2="105" y2="86"></line>
      </g>
      <g fill="none" stroke="#6e767a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.7">
        <path d="M196 84 l8 4 l-8 4"></path>
        <path d="M132 176 l-8 -4 l8 -4"></path>
      </g>
    </svg>
    <span class="inline-block font-semibold text-[0.7rem] tracking-[0.07em] uppercase text-muted border border-line rounded-[3px] px-[11px] py-1 mb-3">
      {pondTag}
    </span>
    <h4 class="text-xl tracking-[-0.01em] mb-1">{pondLabel}</h4>
    <ul class="list-none mt-3.5 grid gap-2.5">
      {pond.map((li) => (
        <li class="relative pl-5 text-muted text-[0.95rem]">
          <span class="absolute left-0.5 top-[0.55em] w-[7px] h-[7px] rounded-full bg-n-400"></span>
          {li}
        </li>
      ))}
    </ul>
  </article>

  <!-- Tubular photobioreactor: vivid, our way (accent border). -->
  <article class="card card--hover card--sheen md:p-7 border-phyco-200!" data-panel="pbr">
    <svg viewBox="0 0 320 200" role="img" aria-label={pbrAlt} class="w-full h-auto block mb-[18px] md:mb-5" style="aspect-ratio: 320/200">
      <rect x="8" y="60" width="38" height="80" rx="8" fill="#eaf8ff" stroke="#a5ddff" stroke-width="1.5"></rect>
      <g>
        <circle cx="18" cy="74" r="2.5" fill="#008edd"></circle>
        <rect x="24" y="71.5" width="16" height="5" rx="2.5" fill="#d1eeff"></rect>
        <rect x="24" y="71.5" width="11" height="5" rx="2.5" fill="#36a9f5"></rect>
        <circle cx="18" cy="92" r="2.5" fill="#008edd"></circle>
        <rect x="24" y="89.5" width="16" height="5" rx="2.5" fill="#d1eeff"></rect>
        <rect x="24" y="89.5" width="14" height="5" rx="2.5" fill="#36a9f5"></rect>
        <circle cx="18" cy="110" r="2.5" fill="#008edd"></circle>
        <rect x="24" y="107.5" width="16" height="5" rx="2.5" fill="#d1eeff"></rect>
        <rect x="24" y="107.5" width="8" height="5" rx="2.5" fill="#36a9f5"></rect>
        <circle cx="18" cy="128" r="2.5" fill="#008edd"></circle>
        <rect x="24" y="125.5" width="16" height="5" rx="2.5" fill="#d1eeff"></rect>
        <rect x="24" y="125.5" width="12" height="5" rx="2.5" fill="#36a9f5"></rect>
      </g>
      <line x1="46" y1="72" x2="84" y2="58" stroke="#36a9f5" stroke-width="4" stroke-linecap="round"></line>
      <line x1="84" y1="142" x2="46" y2="128" stroke="#36a9f5" stroke-width="4" stroke-linecap="round"></line>
      <circle cx="58" cy="132" r="8" fill="#d1eeff" stroke="#008edd" stroke-width="2"></circle>
      <g stroke="#008edd" stroke-width="1.4" stroke-linecap="round">
        <line x1="58" y1="132" x2="58" y2="126"></line>
        <line x1="58" y1="132" x2="63" y2="135"></line>
        <line x1="58" y1="132" x2="53" y2="135"></line>
      </g>
      <rect x="70" y="40" width="192" height="120" rx="12" fill="#eaf8ff" stroke="#a5ddff" stroke-width="1.5"></rect>
      <g stroke="#d1eeff" stroke-width="1.5">
        <line x1="102" y1="46" x2="102" y2="154"></line>
        <line x1="134" y1="46" x2="134" y2="154"></line>
        <line x1="166" y1="46" x2="166" y2="154"></line>
        <line x1="198" y1="46" x2="198" y2="154"></line>
        <line x1="230" y1="46" x2="230" y2="154"></line>
      </g>
      <path d={serpentine} fill="none" stroke="#a5ddff" stroke-width="17" stroke-linecap="round" stroke-linejoin="round"></path>
      <path
        d={serpentine}
        fill="none"
        stroke="#008edd"
        stroke-width="11"
        stroke-linecap="round"
        stroke-linejoin="round"
        pathLength="1"
        class="cmp-fill"
        data-cmp-fill></path>
      <path
        d={serpentine}
        fill="none"
        stroke="#d1eeff"
        stroke-width="3.5"
        stroke-linecap="round"
        stroke-dasharray="2 22"
        class="cmp-shimmer"></path>
      <line x1="246" y1="56" x2="277" y2="45" stroke="#008edd" stroke-width="1.5"></line>
      <circle cx="286" cy="44" r="9" fill="#73c5ff" stroke="#008edd" stroke-width="2"></circle>
      <circle cx="286" cy="44" r="3" fill="#eaf8ff" stroke="none"></circle>
    </svg>
    <span class="inline-block font-semibold text-[0.7rem] tracking-[0.07em] uppercase text-white bg-accent border border-accent rounded-[3px] px-[11px] py-1 mb-3">
      {pbrTag}
    </span>
    <h4 class="text-xl tracking-[-0.01em] mb-1">{pbrLabel}</h4>
    <ul class="list-none mt-3.5 grid gap-2.5">
      {pbr.map((li) => (
        <li class="relative pl-5 text-muted text-[0.95rem]">
          <span class="absolute left-0.5 top-[0.55em] w-[7px] h-[7px] rounded-full bg-accent"></span>
          {li}
        </li>
      ))}
    </ul>
  </article>
</div>

<style>
  /* Ambient loops run only once the block has entered view (is-on). Under
     reduced motion the loops never start and the culture path shows filled. */
  .cmp-evap,
  .cmp-wheel,
  .cmp-raceway,
  .cmp-shimmer {
    animation-play-state: paused;
  }
  [data-compare].is-on .cmp-evap,
  [data-compare].is-on .cmp-wheel,
  [data-compare].is-on .cmp-raceway,
  [data-compare].is-on .cmp-shimmer {
    animation-play-state: running;
  }

  .cmp-evap {
    animation: cmpEvap 4.5s ease-in-out infinite;
  }
  @keyframes cmpEvap {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.45;
    }
    50% {
      transform: translateY(-7px);
      opacity: 0.85;
    }
  }

  .cmp-wheel {
    transform-box: fill-box;
    transform-origin: center;
    animation: cmpSpin 7s linear infinite;
  }
  @keyframes cmpSpin {
    to {
      transform: rotate(360deg);
    }
  }

  .cmp-raceway {
    animation: cmpDrift 3.4s linear infinite;
  }
  @keyframes cmpDrift {
    to {
      stroke-dashoffset: -40;
    }
  }

  .cmp-shimmer {
    animation: cmpShimmer 3s linear infinite 0.6s;
  }
  @keyframes cmpShimmer {
    to {
      stroke-dashoffset: -48;
    }
  }

  /* Serpentine culture path draw-in, driven by GSAP; visible-by-default
     without JS or under reduced motion. */
  :global(html.js) .cmp-fill {
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .cmp-fill {
      stroke-dashoffset: 0;
    }
    .cmp-evap,
    .cmp-wheel,
    .cmp-raceway,
    .cmp-shimmer {
      animation: none;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const root = document.querySelector<HTMLElement>("[data-compare]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (root && !reduce) {
    ScrollTrigger.create({
      trigger: root,
      start: "top 85%",
      once: true,
      onEnter: () => {
        root.classList.add("is-on");
        gsap.to(root.querySelector("[data-cmp-fill]"), {
          strokeDashoffset: 0,
          duration: 1.9,
          ease: "power4.out",
          delay: 0.15,
        });
      },
    });
  } else if (root) {
    root.classList.add("is-on");
  }
</script>
