---
import SectionHead from "@/components/SectionHead.astro";
import ContactForm from "@/components/sections/parts/ContactForm.astro";
import type { SiteContent } from "@/lib/content";
import { privacyPath, type Lang } from "@/i18n/config";
interface Props {
  connect: SiteContent["connect"];
  form: SiteContent["form"];
  lang: Lang;
}
const { connect, form, lang } = Astro.props;
---

<section id="connect" class="section-pad section-alt relative atmos" data-theme="light">
  <div class="container">
    <SectionHead chapter="07" eyebrow={connect.eyebrow} title={connect.title} lede={connect.lede} />

    <div class="grid gap-5 md:grid-cols-2 md:gap-6">
      <article class="card card--hover card--sheen reveal flex flex-col items-start hover:border-phyco-200!" style="--i:0">
        <h3 class="text-[1.3rem] tracking-[-0.01em] mb-4">{connect.investTitle}</h3>
        <p class="text-muted mb-[18px]">
          {connect.investBody}<sup class="fn-mark" aria-hidden="true">*</sup>
        </p>
        <a href="#interest-form" data-interest="investor" class="font-medium text-accent-text hover:underline underline-offset-[3px]">
          {connect.investCta}
        </a>
      </article>
      <article class="card card--hover card--sheen card--glass reveal flex flex-col items-start hover:border-phyco-200!" style="--i:1">
        <h3 class="text-[1.3rem] tracking-[-0.01em] mb-4" set:html={connect.partnerTitle} />
        <p class="text-muted mb-[18px]">{connect.partnerBody}</p>
        <a href="#interest-form" data-interest="partner" class="font-medium text-accent-text hover:underline underline-offset-[3px]">
          {connect.partnerCta}
        </a>
      </article>
    </div>

    <div class="block-gap-md reveal">
      <ContactForm copy={form} lang={lang} privacyHref={privacyPath(lang)} />
    </div>

    <p class="reveal fineprint block-gap-lg mb-[clamp(12px,3vw,32px)] mx-auto max-w-[var(--maxw-narrow)] text-center text-balance">
      <span class="not-italic" aria-hidden="true">*&nbsp;</span>{connect.disclaimer}
    </p>
  </div>
</section>
