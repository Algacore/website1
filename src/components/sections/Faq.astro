---
import SectionHead from "@/components/SectionHead.astro";
import type { SiteContent } from "@/lib/content";

interface Props {
  faq: SiteContent["faq"];
}
const { faq } = Astro.props;

// FAQPage structured data. Answers are the same text the page shows, so the
// rich result can never say more than the page itself.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.items.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<section id="faq" class="section-pad relative atmos border-t border-line" data-theme="light">
  <div class="container">
    <SectionHead chapter="06" eyebrow={faq.eyebrow} title={faq.title} lede={faq.lede} />

    <div class="max-w-[var(--maxw-narrow)] grid gap-3">
      {faq.items.map((item, i) => (
        <details class:list={["faq-item card card--sheen reveal p-0!", i === 0 && "card--glass"]} style={`--i:${i}`}>
          <summary class="faq-q">
            <span>{item.q}</span>
            <svg class="faq-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 9l6 6 6-6"></path>
            </svg>
          </summary>
          <div class="faq-a">
            <p class="text-muted">{item.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  .faq-item {
    overflow: hidden;
    transition: border-color 0.2s;
  }
  .faq-item[open] {
    border-color: var(--color-phyco-200);
  }

  .faq-q {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.25rem;
    cursor: pointer;
    list-style: none;
    padding: clamp(18px, 2.4vw, 24px) clamp(20px, 2.8vw, 28px);
    font-weight: 500;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .faq-q::-webkit-details-marker {
    display: none;
  }
  .faq-q:hover {
    color: var(--color-accent-text);
  }
  .faq-q:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  .faq-chevron {
    width: 20px;
    height: 20px;
    flex: none;
    margin-top: 2px;
    color: var(--color-accent);
    transition: transform 0.25s var(--ease-brand);
  }
  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-a {
    padding: 0 clamp(20px, 2.8vw, 28px) clamp(20px, 2.6vw, 26px);
    max-width: 62ch;
  }
</style>
