---
import "@/styles/global.css";
import { getContent } from "@/lib/content";
import { localeAttr, homePath, legalPath, privacyPath, type Lang } from "@/i18n/config";
import MarkDefs from "@/components/MarkDefs.astro";
import Footer from "@/components/Footer.astro";
import Nav from "@/components/react/Nav.tsx";
import SiteEffects from "@/components/react/SiteEffects.tsx";

interface Props {
  lang: Lang;
  /** Overrides for subpages (legal notice, privacy). */
  title?: string;
  description?: string;
  /** Per-language path of this page, for hreflang alternates. */
  altPath?: (l: Lang) => string;
  /** Anchor the skip link jumps to on this page. */
  skipTarget?: string;
}
const { lang, title, description, altPath = homePath, skipTarget = "#vision" } = Astro.props;
const c = getContent(lang);
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const altLang = lang === "pt" ? "en" : "pt";
const origin = Astro.site ?? new URL(Astro.url.origin);
const absAlt = (l: Lang) => new URL(altPath(l), origin).toString();

const pageTitle = title ?? c.meta.title;
const pageDesc = description ?? c.meta.desc;

// The single-page sections live on the home route, so the nav anchors have to
// be prefixed with the home path whenever we are rendering a subpage.
const onHome = Astro.url.pathname.replace(/\/$/, "") === homePath(lang).replace(/\/$/, "");
const navBase = onHome ? "" : homePath(lang);
---

<!doctype html>
<html lang={localeAttr[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pt-BR" href={absAlt("pt")} />
    <link rel="alternate" hreflang="en" href={absAlt("en")} />
    <link rel="alternate" hreflang="x-default" href={absAlt("pt")} />

    <!-- Type system: Outfit (body/UI/wordmark) + Fraunces (serif display). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..500&family=Outfit:wght@300;400;500;600;700&display=swap"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Social -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Algacore" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:locale" content={localeAttr[lang].replace("-", "_")} />
    <meta property="og:locale:alternate" content={localeAttr[altLang].replace("-", "_")} />
    <meta property="og:image" content="https://algacore.com.br/brand/og/og-card.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Algacore" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content="https://algacore.com.br/brand/og/og-card.png" />
    <meta name="twitter:image:alt" content="Algacore" />

    <!-- Structured data. Algacore is a project in formation, so this claims no
         registered entity, no founding date and no service on offer. -->
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Algacore",
        "alternateName": ["Alga Core", "Core Alga", "AlgaCore", "Algacore Biotecnologia", "Algacore Ficocianina"],
        "url": "https://algacore.com.br",
        "logo": "https://algacore.com.br/brand/square/algacore-logo-square.png",
        "description": lang === "pt"
          ? "Projeto de biotecnologia B2B em constituição, desenvolvendo o cultivo de spirulina em fotobiorreatores fechados para a extração de ficocianina de alto grau no Brasil."
          : "B2B biotechnology venture in formation, developing spirulina cultivation in closed photobioreactors for the extraction of high-grade phycocyanin in Brazil.",
        "email": "contato@algacore.com.br",
        "areaServed": ["BR", "LATAM"],
        "knowsAbout": ["phycocyanin", "spirulina", "photobioreactor", "ficocianina", "biotechnology"],
        "sameAs": []
      },
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Algacore",
        "alternateName": ["Alga Core", "Core Alga", "Algacore Ficocianina"],
        "url": "https://algacore.com.br"
      }
    ])} />

    <!-- Mark the document JS-capable before first paint so scroll-reveal styles
         only apply when JS can drive them (no hidden content without JS). -->
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"></div>
    <a class="skip-link" href={skipTarget}>{c.a11y.skip}</a>

    <MarkDefs />

    <Nav
      client:load
      lang={lang}
      navTeam={c.nav.team}
      navContact={c.nav.contact}
      langLabel={c.langToggleLabel}
      basePath={navBase}
      homeHref={homePath(lang)}
      ptHref={altPath("pt")}
      enHref={altPath("en")}
    />

    <main>
      <slot />
    </main>

    <Footer
      copy={c.footer.copy}
      mail={c.footer.mail}
      legalLabel={c.footer.legal}
      legalHref={legalPath(lang)}
      privacyLabel={c.footer.privacy}
      privacyHref={privacyPath(lang)}
    />

    <SiteEffects client:load />
  </body>
</html>
